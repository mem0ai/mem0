{
  "description": "Create memories from coding sessions, search them during later work.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/hook.py\" --harness harmless session-start --plugin-data-dir \"${PLUGIN_DATA}\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/hook.py\" --harness harmless user-prompt --plugin-data-dir \"${PLUGIN_DATA}\"",
            "timeout": 6
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/hook.py\" --harness harmless post-tool --plugin-data-dir \"${PLUGIN_DATA}\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/hook.py\" --harness harmless stop --plugin-data-dir \"${PLUGIN_DATA}\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/hook.py\" --harness harmless flush --reason session-end --plugin-data-dir \"${PLUGIN_DATA}\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
